<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机自启动：用于设备重启后重新注册定时器 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟（API 31+）：Device Owner 自动豁免，声明兜底 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 睡眠模式开始/恢复通知（API 33+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 【实验】阶段7 时区权限路线验证（WRITE_SETTINGS 通道），仅为实验，不代表最终产品方案 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:name=".SleepShiftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepShift">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 人格分享卡片页（SL-6.5） -->
        <activity
            android:name=".PersonalityCardActivity"
            android:exported="false" />

        <!-- 能力状态调试页（开发验证用，独立于主流程） -->
        <activity
            android:name=".DebugActivity"
            android:exported="true" />

        <!-- Shizuku 授权 Provider（Shizuku Mode 必需） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 人格卡片分享 FileProvider（SL-6.5） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 设备管理员接收器：Device Owner 授权与回调必须用它 -->
        <receiver
            android:name=".admin.DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 精确闹钟接收器：ACTION_SHIFT / ACTION_RESTORE（exported 以便 adb 手动测试触发） -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="true" />

        <!-- 开机 / 应用更新后重新武装调度 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 睡了么 2x1 小组件（SL-3） -->
        <receiver
            android:name=".shuileme.widget.ShuilemeSmallWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shuileme_widget_small" />
        </receiver>

        <!-- 睡了么 4x2 中组件（SL-3） -->
        <receiver
            android:name=".shuileme.widget.ShuilemeMediumWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shuileme_widget_medium" />
        </receiver>

        <!-- 组件周期刷新 + 开机重排（SL-3） -->
        <receiver
            android:name=".shuileme.widget.ShuilemeWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sleepshift.action.WIDGET_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 睡眠提醒（SL-4）：睡前/熬夜检查点/今晚放过我 -->
        <receiver
            android:name=".shuileme.reminder.ShuilemeReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sleepshift.action.SLEEP_REMINDER" />
                <action android:name="com.sleepshift.action.LATE_CHECKPOINT" />
                <action android:name="com.sleepshift.action.NIGHT_OFF" />
            </intent-filter>
        </receiver>

        <!-- 睡眠胶囊（SL-9.2）：「我醒啦」动作 -->
        <receiver
            android:name=".shuileme.reminder.SleepCapsuleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sleepshift.action.CAPSULE_WAKE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
